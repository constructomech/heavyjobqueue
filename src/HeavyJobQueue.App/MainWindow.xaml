<Window x:Class="HeavyJobQueue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeavyJobQueue.App"
        Title="Heavy Job Queue"
        Height="800"
        Width="1280"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Heavy Job Queue" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Heavy jobs run one at a time unless you explicitly approve an override." />
        </StackPanel>

        <GroupBox Grid.Row="1" Margin="0,20,0,16" Header="Active jobs">
            <DataGrid x:Name="ActiveGrid"
                      Margin="10"
                      MinHeight="58"
                      MaxHeight="150"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ToolTipService.BetweenShowDelay="100"
                      ToolTipService.InitialShowDelay="300"
                      ToolTipService.ShowDuration="60000">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Command}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="110" Binding="{Binding Mode}" Header="Mode" />
                    <DataGridTextColumn Width="2*" Binding="{Binding Label}" Header="Label" />
                    <DataGridTextColumn Width="80" Binding="{Binding Pid}" Header="PID" />
                    <DataGridTextColumn Width="3*" Binding="{Binding Cwd}" Header="Working directory" />
                    <DataGridTextColumn Width="100" Binding="{Binding Elapsed}" Header="Running" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Margin="0,0,0,16" Header="System utilization">
            <local:PerformanceHistoryControl x:Name="PerformanceHistory" Margin="8" />
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Waiting jobs">
            <DataGrid x:Name="WaitingGrid"
                      Margin="10"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ToolTipService.BetweenShowDelay="100"
                      ToolTipService.InitialShowDelay="300"
                      ToolTipService.ShowDuration="60000">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Command}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="44" Binding="{Binding Position}" Header="#" />
                    <DataGridTextColumn Width="80" Binding="{Binding Status}" Header="Status" />
                    <DataGridTextColumn Width="2*" Binding="{Binding Label}" Header="Label" />
                    <DataGridTextColumn Width="80" Binding="{Binding Pid}" Header="PID" />
                    <DataGridTextColumn Width="3*" Binding="{Binding Cwd}" Header="Working directory" />
                    <DataGridTextColumn Width="100" Binding="{Binding Elapsed}" Header="Waiting" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Closing this window keeps the broker running in the tray." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90"
                        Margin="8,0,0,0"
                        Background="{DynamicResource WarningButtonBrush}"
                        Click="RunNow_Click"
                        Content="Run now" />
                <Button Width="110"
                        Margin="8,0,0,0"
                        Click="PauseResume_Click"
                        Content="Pause / resume" />
                <Button Width="90" Margin="8,0,0,0" Click="MoveUp_Click" Content="Move up" />
                <Button Width="90" Margin="8,0,0,0" Click="MoveDown_Click" Content="Move down" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
