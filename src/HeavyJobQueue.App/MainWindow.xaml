<Window x:Class="HeavyJobQueue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heavy Job Queue"
        Height="560"
        Width="920"
        MinHeight="420"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Heavy Job Queue" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#666"
                       Text="Compilation, CMake, and benchmark jobs run one at a time." />
        </StackPanel>

        <GroupBox Grid.Row="1" Margin="0,20,0,16" Header="Active job">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActiveLabel"
                           FontWeight="SemiBold"
                           Text="No active job"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ActivePid"
                           Grid.Column="1"
                           Margin="20,0"
                           Foreground="#555" />
                <TextBlock x:Name="ActiveCwd"
                           Grid.Column="2"
                           Foreground="#555"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                <TextBlock x:Name="ActiveElapsed"
                           Grid.Column="3"
                           Margin="20,0,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Waiting jobs">
            <DataGrid x:Name="WaitingGrid"
                      Margin="10"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="44" Binding="{Binding Position}" Header="#" />
                    <DataGridTextColumn Width="2*" Binding="{Binding Label}" Header="Label" />
                    <DataGridTextColumn Width="80" Binding="{Binding Pid}" Header="PID" />
                    <DataGridTextColumn Width="3*" Binding="{Binding Cwd}" Header="Working directory" />
                    <DataGridTextColumn Width="100" Binding="{Binding Elapsed}" Header="Waiting" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#666"
                       Text="Closing this window keeps the broker running in the tray." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90" Margin="8,0,0,0" Click="MoveUp_Click" Content="Move up" />
                <Button Width="90" Margin="8,0,0,0" Click="MoveDown_Click" Content="Move down" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
